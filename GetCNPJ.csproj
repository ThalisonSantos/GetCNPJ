<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net48;net481;net8.0;net9.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**</DefaultItemExcludes>

        <!-- Package Information -->
        <PackageId>GetCNPJ.Community</PackageId>
        <Version>1.1.0</Version>
        <Title>GetCNPJ Community</Title>
        <Authors>Bruno da Cunha Felipe;Thalison Santos</Authors>
        <Copyright>Copyright (c) 2025 Bruno da Cunha Felipe</Copyright>
        <Description>Fork independente do GetCNPJ de Bruno da Cunha Felipe, mantido por Thalison Santos. Consulta CNPJ via CNPJ.WS, ReceitaWS, BrasilAPI e CNPJá; validação local numérica e alfanumérica, rate limiting e fallback. .NET Standard 2.0, .NET Framework 4.8/4.8.1, .NET 8 e .NET 9. Homologação real parcial de consultas numéricas; suporte operacional alfanumérico externo não comprovado.</Description>
        <PackageTags>CNPJ;Brasil;Community;CNPJWS;ReceitaWS;BrasilAPI;CNPJA;Validacao;Alfanumerico</PackageTags>
        <PackageProjectUrl>https://github.com/ThalisonSantos/GetCNPJ</PackageProjectUrl>
        <RepositoryUrl>https://github.com/ThalisonSantos/GetCNPJ</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>Estabilização do fork independente: validação de CNPJ numérico/alfanumérico, concorrência, timeout/fallback, recursos HTTP e contratos de provedores. Consulte CHANGELOG.md e docs/PROVIDERS.md. Homologação real parcial numérica; APIs alfanuméricas não testadas.</PackageReleaseNotes>
        <AssemblyName>GetCNPJ</AssemblyName>
        <RootNamespace>GetCNPJ</RootNamespace>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.1.0.0</FileVersion>
        <IncludeSource>false</IncludeSource>
    </PropertyGroup>

    <!-- O projeto na raiz não deve compilar nem empacotar a infraestrutura de testes. -->
    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
        <EmbeddedResource Remove="tests/**/*" />
        <None Remove="tests/**/*" />
        <Compile Remove="tools/**/*.cs" />
        <EmbeddedResource Remove="tools/**/*" />
        <None Remove="tools/**/*" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net48' OR '$(TargetFramework)' == 'net481'">
        <PackageReference Include="System.Text.Json" Version="8.0.6" />
    </ItemGroup>

    <!-- Usa o assembly fornecido pelo .NET Framework, sem o pacote legado. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48' OR '$(TargetFramework)' == 'net481'">
        <Reference Include="System.Net.Http" />
    </ItemGroup>

    <!-- Lista explícita: não distribuir fontes de testes, imagens sem autorização ou artefatos. -->
    <ItemGroup>
        <Content Update="**/*" Pack="false" />
        <None Update="**/*" Pack="false" />
        <None Remove="README.md;LICENSE;CHANGELOG.md;docs/PROVIDERS.md;docs/DEPENDENCIES.md" />
        <None Include="README.md;LICENSE;CHANGELOG.md" Pack="true" PackagePath="\" />
        <None Include="docs/PROVIDERS.md;docs/DEPENDENCIES.md" Pack="true" PackagePath="docs/" />
    </ItemGroup>

</Project>
